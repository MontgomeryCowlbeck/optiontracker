# Data Provider Configuration
# Options: "yahoo" (free, no API key needed) or "tastytrade" (requires OAuth2 credentials)
DATA_PROVIDER=tastytrade

# Tastytrade OAuth2 Configuration
# 1. Go to https://developer.tastytrade.com and create an OAuth application
# 2. Under your app, click "Create Grant" to generate an initial refresh token
# TASTYTRADE_CLIENT_SECRET — from your OAuth app settings
# TASTYTRADE_REFRESH_TOKEN — long-lived token from "Create Grant"; never expires
TASTYTRADE_CLIENT_SECRET=your_client_secret_here
TASTYTRADE_REFRESH_TOKEN=your_refresh_token_here
TASTYTRADE_SANDBOX=false

# Finnhub API Configuration (free tier available at finnhub.io)
# Used for earnings calendar
FINNHUB_API_KEY=your_finnhub_api_key_here

# Database Configuration
DATABASE_PATH=/app/data/options.db

# Scheduler Configuration (cron format: minute hour day month day_of_week)
# Default: 10:00, 12:30, 15:30 ET on weekdays
FETCH_SCHEDULE=0 10,12,15 * * 1-5

# JWT Authentication
# IMPORTANT: Generate a secure secret and keep it consistent across restarts
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_secret_key_here
JWT_EXPIRE_DAYS=30
